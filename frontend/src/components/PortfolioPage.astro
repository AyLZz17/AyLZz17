---
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import SocialIcon from '../components/SocialIcon.astro'
import { certificates, profile, projects, socialLinks, stack } from '../data/portfolio'
import { translations, type Language } from '../data/translations'

interface Props {
  lang: Language
}

const { lang } = Astro.props
const copy = translations[lang]
const localizedProfile = {
  ...profile,
  summary: copy.hero.summary,
  whatsapp: `${profile.whatsapp}?text=${encodeURIComponent(copy.contact.whatsappMessage)}`,
}
const localizedSocialLinks = socialLinks.map((social, index) => ({
  ...social,
  handle: copy.social.handles[index],
}))
const localizedStack = stack.map((group, index) => ({
  ...group,
  category: copy.stack.categories[index],
}))
const localizedProjects = projects.map((project, index) => ({
  ...project,
  ...copy.projects.items[index],
}))
const localizedCertificates = certificates.map((certificate, index) => ({
  ...certificate,
  ...copy.certificates.items[index],
}))
const projectMarks = ['XMR', 'MAI', 'ZRO']
---

<BaseLayout
  lang={lang}
  title={copy.metadata.title}
  description={copy.metadata.description}
>
  <div class="backdrop" aria-hidden="true"></div>
  <div class="noise" aria-hidden="true"></div>

  <header class="site-header">
    <a class="brand" href="#inicio" aria-label={copy.brandHome}>
      <img class="brand-avatar" src={localizedProfile.githubAvatar} alt="" />
      <span class="brand-name">DANIEL AYALA<span class="brand-dot">.</span></span>
      <span class="brand-nickname">AYLZZ</span>
    </a>
    <nav class="main-nav" aria-label={copy.navigation.label}>
      <a href="#perfil">{copy.navigation.profile}</a>
      <a href="#proyectos">{copy.navigation.projects}</a>
      <a href="#stack">{copy.navigation.stack}</a>
      <a href="#enfoque">{copy.navigation.focus}</a>
      <a href="#certificados">{copy.navigation.certificates}</a>
      <a href="#contacto">{copy.navigation.contact}</a>
    </nav>
    <a class="header-cta" href="#contacto">{copy.navigation.talk} <span aria-hidden="true">↗</span></a>
    <nav class="language-switch" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
      <a
        href={lang === 'es' ? '/en/' : '/'}
        hreflang={lang === 'es' ? 'en' : 'es'}
        lang={lang === 'es' ? 'en' : 'es'}
        data-language-link
        data-language-target={lang === 'es' ? 'en' : 'es'}
        aria-label={copy.switchLanguage}
      >
        {lang === 'es' ? 'EN' : 'ES'}
      </a>
    </nav>
  </header>

  <main class="page-content">
    <section id="inicio" class="hero section-anchor">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> {copy.hero.eyebrow} <span class="eyebrow-divider">/</span> {localizedProfile.nickname}</p>
        <h1>{copy.hero.greeting}<br />Daniel <span>Ayala.</span></h1>
        <p class="hero-summary">{localizedProfile.summary}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#proyectos">{copy.hero.viewProjects} <span aria-hidden="true">↘</span></a>
          <a class="button button-secondary" href="#contacto">{copy.hero.talk} <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="hero-identity" data-reveal role="group" aria-label={copy.hero.identityLabel}>
        <div class="identity-orbit identity-orbit-one" aria-hidden="true"></div>
        <div class="identity-orbit identity-orbit-two" aria-hidden="true"></div>
        <span class="identity-monogram" aria-hidden="true">AYLZ<span class="identity-code-mark">&lt;/&gt;</span></span>
        <div class="identity-card glass">
          <div class="identity-card-top">
            <div class="identity-name">
              <img class="identity-avatar" src={localizedProfile.githubAvatar} alt={copy.hero.avatarAlt} />
              <span><strong>AYLZZ</strong><small>@AyLZz17 · Daniel Ayala</small></span>
            </div>
            <span class="identity-code">&lt;/&gt;</span>
          </div>
          <div class="identity-focus"><span>WEB</span><span>APIs</span><span>{copy.hero.data}</span><span>CLOUD</span></div>
        </div>
        <nav class="identity-socials" aria-label={copy.social.socials}>
          <a class="contact-social-link" href={localizedProfile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
            <SocialIcon name="GitHub" />
          </a>
          {localizedSocialLinks.map((social) => (
            social.href ? (
              <a class="contact-social-link" href={social.href} target="_blank" rel="noreferrer" aria-label={social.name}>
                <SocialIcon name={social.name} />
              </a>
            ) : (
              <span
                class="contact-social-link contact-social-pending"
                aria-label={`${social.name}: ${social.handle}`}
              >
                <SocialIcon name={social.name} />
              </span>
            )
          ))}
        </nav>
        <span class="hero-ornament" aria-hidden="true">AYLZZ / 01</span>
      </div>
    </section>

    <div class="hero-footer">
      <span>{copy.hero.footerLeft}</span>
      <a href="#perfil">{copy.hero.footerLink} <span aria-hidden="true">↓</span></a>
      <span>{copy.hero.footerRight}</span>
    </div>

    <section id="perfil" class="section-anchor section-block">
      <SectionHeading number="01" title={copy.profile.title} subtitle={copy.profile.subtitle} />
      <div class="profile-layout">
        <div class="profile-photo glass" data-reveal>
          <img src={localizedProfile.developerPhoto} alt={copy.profile.photoAlt} loading="lazy" />
          <span class="photo-caption">DANIEL AYALA <span>·</span> {copy.profile.photoCaption}</span>
        </div>
        <div class="profile-copy" data-reveal>
          <p class="profile-lead">
            {copy.profile.lead}
          </p>
          {copy.profile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <a class="inline-link" href={localizedProfile.github} target="_blank" rel="noreferrer">
            {copy.profile.githubLink} <span aria-hidden="true">↗</span>
          </a>
          <div class="profile-facts">
            {copy.profile.facts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
          </div>
        </div>
      </div>
    </section>

    <section id="proyectos" class="section-anchor section-block">
      <SectionHeading number="02" title={copy.projects.title} subtitle={copy.projects.subtitle} />
      <p class="section-intro">{copy.projects.intro}</p>
      <div class="project-grid">
        {localizedProjects.map((project, index) => (
          <article class="project-card glass" data-reveal data-tilt>
            <div class:list={['project-visual', `project-visual-${index + 1}`]} aria-hidden="true">
              <span class="project-orbit"></span>
              <span class="project-mark">{projectMarks[index] ?? 'WEB'}</span>
              <span class="project-visual-caption">{project.category}</span>
              <span class="project-visual-arrow">↗</span>
            </div>
            <div class="project-content">
              <div class="project-meta">
                <span>{copy.projects.label} 0{index + 1}</span>
                <span>{project.category}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="project-bottom">
                <ul class="project-tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                <div class="project-links">
                  {project.repository && (
                    <a href={project.repository} target="_blank" rel="noreferrer">{copy.projects.code} <span aria-hidden="true">↗</span></a>
                  )}
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noreferrer">{copy.projects.demo} <span aria-hidden="true">↗</span></a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
      <a class="all-projects-link" href={localizedProfile.repositories} target="_blank" rel="noreferrer">
        {copy.projects.more} <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section id="stack" class="section-anchor section-block stack-section">
      <SectionHeading number="03" title={copy.stack.title} subtitle={copy.stack.subtitle} />
      <p class="section-intro">{copy.stack.intro}</p>
      <div class="stack-grid">
        {localizedStack.map((group, index) => (
          <article class="stack-card glass" data-reveal data-tilt>
            <div class="card-topline">
              <span class="stack-number">0{index + 1}</span>
              <span class="stack-spark" aria-hidden="true">✳</span>
            </div>
            <h3>{group.category}</h3>
            <ul class="tag-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="enfoque" class="section-anchor section-block focus-section">
      <SectionHeading number="04" title={copy.focus.title} subtitle={copy.focus.subtitle} />
      <div class="focus-layout">
        <div class="focus-list">
          <article data-reveal>
            <span>01</span>
            <div>
              <h3>{copy.focus.steps[0].title}</h3>
              <p>{copy.focus.steps[0].description}</p>
            </div>
          </article>
          <article data-reveal>
            <span>02</span>
            <div>
              <h3>{copy.focus.steps[1].title}</h3>
              <p>{copy.focus.steps[1].description}</p>
            </div>
          </article>
        </div>
        <aside class="learning-card glass" data-reveal data-tilt>
          <span class="eyebrow">{copy.focus.learning}</span>
          <h3>{copy.focus.learningTitle}</h3>
          <p>{copy.focus.learningDescription}</p>
        </aside>
      </div>
    </section>

    <section id="github" class="section-anchor section-block github-section">
      <SectionHeading number="05" title={copy.github.title} subtitle={copy.github.subtitle} />
      <div class="github-card glass" data-reveal data-tilt>
        <div class="github-copy">
          <span class="github-kicker">GITHUB / @AYLZZ17</span>
          <p>{copy.github.description}</p>
          <a class="button button-secondary" href={localizedProfile.repositories} target="_blank" rel="noreferrer">
            {copy.github.visit} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <img
          class="github-stats"
          src={localizedProfile.githubStats}
          alt={copy.github.statsAlt}
          loading="lazy"
        />
      </div>
    </section>

    <section id="certificados" class="section-anchor section-block certificates-section">
      <SectionHeading number="06" title={copy.certificates.title} subtitle={copy.certificates.subtitle} />
      <p class="section-intro">{copy.certificates.intro}</p>
      <div class="certificate-grid">
        {localizedCertificates.map((certificate, index) => (
          <article class="certificate-card glass" data-reveal data-tilt>
            <div class:list={['certificate-art', !certificate.image && 'certificate-document']}>
              {certificate.image ? (
                <img src={certificate.image} alt={copy.certificates.badgeAlt} loading="lazy" />
              ) : (
                <div class="document-mark" aria-hidden="true"><span>PDF</span><strong>✳</strong></div>
              )}
              <span class="certificate-index">0{index + 1} / {copy.certificates.label}</span>
            </div>
            <div class="certificate-copy">
              <span class="certificate-issuer">{certificate.issuer}</span>
              <h3>{certificate.title}</h3>
              <p>{certificate.type}</p>
              <a href={certificate.file} target="_blank" rel="noreferrer">
                {copy.certificates.view} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="contacto" class="section-anchor contact-section">
      <p class="eyebrow">08 / {copy.contact.eyebrow}</p>
      <div class="contact-main">
        <div>
          <h2>{copy.contact.title[0]}<br /><span>{copy.contact.title[1]}</span></h2>
          <p>{copy.contact.description}</p>
        </div>
        <span class="contact-orbit" aria-hidden="true">AYLZZ<span>✳</span></span>
      </div>
      <div class="contact-actions">
        <a class="contact-option glass" href={localizedProfile.email}>
          <span class="contact-icon" aria-hidden="true">✉</span>
          <span><small>{copy.contact.email}</small><strong>aylz.contact@gmail.com</strong></span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="contact-option glass" href={localizedProfile.whatsapp} target="_blank" rel="noreferrer">
          <span class="contact-icon" aria-hidden="true">↗</span>
          <span><small>{copy.contact.whatsapp}</small><strong>{copy.contact.sendMessage}</strong></span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <nav class="contact-socials" aria-label={copy.contact.socials}>
        <a class="contact-social-link" href={localizedProfile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <SocialIcon name="GitHub" />
        </a>
        {localizedSocialLinks.map((social) => (
          social.href ? (
            <a class="contact-social-link" href={social.href} target="_blank" rel="noreferrer" aria-label={social.name}>
              <SocialIcon name={social.name} />
            </a>
          ) : (
            <span
              class="contact-social-link contact-social-pending"
              aria-label={`${social.name}: ${social.handle}`}
            >
              <SocialIcon name={social.name} />
            </span>
          )
        ))}
      </nav>
    </section>

    <footer class="site-footer">
      <a class="footer-brand" href="#inicio">DANIEL AYALA<span>.</span></a>
      <span>© {new Date().getFullYear()} DANIEL AYALA · AYLZZ. {copy.footer.copyright}</span>
      <a href="#inicio">{copy.footer.backToTop} <span aria-hidden="true">↑</span></a>
    </footer>
  </main>

  <script>
    const languageLinks = document.querySelectorAll<HTMLAnchorElement>('[data-language-link]')

    languageLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const selectedLanguage = link.dataset.languageTarget

        if (selectedLanguage === 'es' || selectedLanguage === 'en') {
          localStorage.setItem('aylzz-portfolio-language', selectedLanguage)
        }

        if (window.location.hash) {
          link.href = `${link.href.split('#')[0]}${window.location.hash}`
        }
      })
    })

    if (window.location.pathname === '/') {
      const savedLanguage = localStorage.getItem('aylzz-portfolio-language')
      const preferredLanguage = navigator.languages[0] || navigator.language
      const prefersEnglish = preferredLanguage.toLowerCase().startsWith('en')

      if (savedLanguage === 'en' || (savedLanguage !== 'es' && prefersEnglish)) {
        window.location.replace(`/en/${window.location.hash}`)
      }
    }

    const revealElements = document.querySelectorAll<HTMLElement>('[data-reveal]')

    if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.body.classList.add('motion-ready')

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.14 },
      )

      revealElements.forEach((element) => revealObserver.observe(element))
    }

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect()
          const x = (event.clientX - bounds.left) / bounds.width
          const y = (event.clientY - bounds.top) / bounds.height
          card.style.setProperty('--pointer-x', `${x * 100}%`)
          card.style.setProperty('--pointer-y', `${y * 100}%`)
          card.style.setProperty('--tilt-x', `${(0.5 - y) * 3}deg`)
          card.style.setProperty('--tilt-y', `${(x - 0.5) * 3}deg`)
        })

        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--tilt-x', '0deg')
          card.style.setProperty('--tilt-y', '0deg')
        })
      })
    }
  </script>
</BaseLayout>
