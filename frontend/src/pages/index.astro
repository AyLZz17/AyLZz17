---
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import SocialIcon from '../components/SocialIcon.astro'
import { certificates, profile, projects, socialLinks, stack } from '../data/portfolio'
---

<BaseLayout
  title="Daniel Ayala (AYLZZ) | Desarrollador de software"
  description="Portafolio de Daniel Ayala, AYLZZ. Especializado en desarrollo backend, APIs, bases de datos y automatización; conocimientos básicos de frontend."
>
  <div class="backdrop" aria-hidden="true"></div>
  <div class="noise" aria-hidden="true"></div>

  <header class="site-header">
    <a class="brand" href="#inicio" aria-label="Daniel Ayala, inicio">
      <img class="brand-avatar" src={profile.githubAvatar} alt="" />
      <span class="brand-name">DANIEL AYALA<span class="brand-dot">.</span></span>
      <span class="brand-nickname">AYLZZ</span>
    </a>
    <nav class="main-nav" aria-label="Navegación principal">
      <a href="#perfil">Perfil</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#stack">Stack</a>
      <a href="#enfoque">Enfoque</a>
      <a href="#certificados">Certificados</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <a class="header-cta" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
  </header>

  <main class="page-content">
    <section id="inicio" class="hero section-anchor">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> SOFTWARE DEVELOPER <span class="eyebrow-divider">/</span> {profile.nickname}</p>
        <h1>Hola, soy<br />Daniel <span>Ayala.</span></h1>
        <p class="hero-summary">{profile.summary}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#proyectos">Ver proyectos <span aria-hidden="true">↘</span></a>
          <a class="button button-secondary" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="hero-identity" data-reveal role="img" aria-label="Identidad visual de AyLZz">
        <div class="identity-orbit identity-orbit-one"></div>
        <div class="identity-orbit identity-orbit-two"></div>
        <span class="identity-monogram" aria-hidden="true">AYLZ<span class="identity-code-mark">&lt;/&gt;</span></span>
        <div class="identity-card glass">
          <div class="identity-card-top">
            <div class="identity-name">
              <img class="identity-avatar" src={profile.githubAvatar} alt="Foto de perfil de GitHub de AYLZZ" />
              <span><strong>AYLZZ</strong><small>@AyLZz17 · Daniel Ayala</small></span>
            </div>
            <span class="identity-code">&lt;/&gt;</span>
          </div>
          <div class="identity-focus"><span>WEB</span><span>APIs</span><span>DATOS</span><span>CLOUD</span></div>
        </div>
        <span class="hero-ornament" aria-hidden="true">AYLZZ / 01</span>
      </div>
    </section>

    <div class="hero-footer">
      <span>DESARROLLO FULL-STACK</span>
      <a href="#perfil">CONOCE MÁS SOBRE MÍ <span aria-hidden="true">↓</span></a>
      <span>APRENDIENDO Y CONSTRUYENDO</span>
    </div>

    <section id="perfil" class="section-anchor section-block">
      <SectionHeading number="01" title="Un poco sobre mí" subtitle="Perfil" />
      <div class="profile-layout">
        <div class="profile-photo glass" data-reveal>
          <img src={profile.developerPhoto} alt="Daniel Ayala en retrato" loading="lazy" />
          <span class="photo-caption">DANIEL AYALA <span>·</span> DESARROLLADOR DE SOFTWARE</span>
        </div>
        <div class="profile-copy" data-reveal>
          <p class="profile-lead">
            Convierto necesidades reales en soluciones digitales claras, escalables y mantenibles.
          </p>
          <p>
            Como desarrollador de software, estoy enfocado en transformar necesidades reales de negocio en
            soluciones digitales claras, funcionales y altamente escalables. Mi trabajo combina la ingeniería
            de software aplicada al backend, la construcción de APIs robustas y el despliegue en la nube,
            garantizando productos estables que aportan valor tangible desde el primer día.
          </p>
          <p>
            Me especializo en crear el backend para aplicaciones web full-stack: desde la arquitectura de
            bases de datos y la integración de servicios hasta MVPs con interfaces ágiles e intuitivas.
            Abordo cada proyecto con buenas prácticas, automatización, seguridad y rendimiento. Si buscas
            llevar una idea al mundo digital, estructurar una plataforma para tu negocio o potenciar tus
            servicios web, construyamos algo juntos.
          </p>
          <p>
            Actualmente sigo aprendiendo sobre machine learning, AWS y herramientas de inteligencia artificial
            aplicadas al desarrollo.
          </p>
          <a class="inline-link" href={profile.github} target="_blank" rel="noreferrer">
            Explorar mi perfil de GitHub <span aria-hidden="true">↗</span>
          </a>
          <div class="profile-facts">
            <div><strong>Backend</strong><span>Especialidad</span></div>
            <div><strong>Colombia</strong><span>Ubicación</span></div>
            <div><strong>AYLZZ</strong><span>Mi nickname</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="proyectos" class="section-anchor section-block">
      <SectionHeading number="02" title="Del código a lo concreto" subtitle="Proyectos en desarrollo continuo" />
      <p class="section-intro">
        Dos proyectos en evolución constante, con una misma intención: construir soluciones útiles.
      </p>
      <div class="project-grid">
        {projects.map((project, index) => (
          <article class="project-card glass" data-reveal data-tilt>
            <div class:list={['project-visual', `project-visual-${index + 1}`]} aria-hidden="true">
              <span class="project-orbit"></span>
              <span class="project-mark">{index === 0 ? 'XMR' : 'MAI'}</span>
              <span class="project-visual-caption">{project.category}</span>
              <span class="project-visual-arrow">↗</span>
            </div>
            <div class="project-content">
              <div class="project-meta">
                <span>PROYECTO 0{index + 1}</span>
                <span>{project.category}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="project-bottom">
                <ul class="project-tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                <div class="project-links">
                  <a href={project.repository} target="_blank" rel="noreferrer">Código <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
      <a class="all-projects-link" href={profile.repositories} target="_blank" rel="noreferrer">
        MÁS PROYECTOS EN GITHUB <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section id="stack" class="section-anchor section-block stack-section">
      <SectionHeading number="03" title="Las piezas con las que construyo" subtitle="Stack & herramientas" />
      <p class="section-intro">
        Un ecosistema para conectar interfaces, lógica de negocio, datos e infraestructura.
      </p>
      <div class="stack-grid">
        {stack.map((group, index) => (
          <article class="stack-card glass" data-reveal data-tilt>
            <div class="card-topline">
              <span class="stack-number">0{index + 1}</span>
              <span class="stack-spark" aria-hidden="true">✳</span>
            </div>
            <h3>{group.category}</h3>
            <ul class="tag-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="enfoque" class="section-anchor section-block focus-section">
      <SectionHeading number="04" title="Construir. Entender. Evolucionar." subtitle="Enfoque" />
      <div class="focus-layout">
        <div class="focus-list">
          <article data-reveal>
            <span>01</span>
            <div>
              <h3>Entender antes de construir.</h3>
              <p>Partir de necesidades reales y conectar cada decisión técnica con el valor que puede aportar al negocio.</p>
            </div>
          </article>
          <article data-reveal>
            <span>02</span>
            <div>
              <h3>Cuidar lo que no se ve.</h3>
              <p>Arquitectura clara, control de versiones y documentación para crear soluciones escalables y mantenibles.</p>
            </div>
          </article>
        </div>
        <aside class="learning-card glass" data-reveal data-tilt>
          <span class="eyebrow">APRENDIZAJE CONTINUO</span>
          <h3>Machine learning, AWS e inteligencia artificial.</h3>
          <p>Continúo fortaleciendo mis conocimientos y explorando cómo aplicar estas herramientas al desarrollo de soluciones digitales.</p>
        </aside>
      </div>
    </section>

    <section id="github" class="section-anchor section-block github-section">
      <SectionHeading number="05" title="Más sobre mi trabajo" subtitle="GitHub" />
      <div class="github-card glass" data-reveal data-tilt>
        <div class="github-copy">
          <span class="github-kicker">GITHUB / @AYLZZ17</span>
          <p>Siempre aprendiendo, construyendo y mejorando soluciones digitales.</p>
          <a class="button button-secondary" href={profile.repositories} target="_blank" rel="noreferrer">
            Visitar mi GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <img
          class="github-stats"
          src={profile.githubStats}
          alt="Estadísticas públicas de GitHub de AyLZz17"
          loading="lazy"
        />
      </div>
    </section>

    <section id="certificados" class="section-anchor section-block certificates-section">
      <SectionHeading number="06" title="Formación y certificados" subtitle="Certificaciones" />
      <p class="section-intro">
        Insignias y documentos de formación que respaldan mi aprendizaje continuo.
      </p>
      <div class="certificate-grid">
        {certificates.map((certificate, index) => (
          <article class="certificate-card glass" data-reveal data-tilt>
            <div class:list={['certificate-art', !certificate.image && 'certificate-document']}>
              {certificate.image ? (
                <img src={certificate.image} alt="Insignia AWS Academy Cloud Foundations" loading="lazy" />
              ) : (
                <div class="document-mark" aria-hidden="true"><span>PDF</span><strong>✳</strong></div>
              )}
              <span class="certificate-index">0{index + 1} / CERTIFICADO</span>
            </div>
            <div class="certificate-copy">
              <span class="certificate-issuer">{certificate.issuer}</span>
              <h3>{certificate.title}</h3>
              <p>{certificate.type}</p>
              <a href={certificate.file} target="_blank" rel="noreferrer">
                Ver certificado <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="contacto" class="section-anchor contact-section">
      <p class="eyebrow">08 / CONTACTO</p>
      <div class="contact-main">
        <div>
          <h2>¿Creamos algo<br /><span>bueno juntos?</span></h2>
          <p>Cuéntame sobre tu idea o proyecto. Será un gusto conversar contigo.</p>
        </div>
        <span class="contact-orbit" aria-hidden="true">AYLZZ<span>✳</span></span>
      </div>
      <div class="contact-actions">
        <a class="contact-option glass" href={profile.email}>
          <span class="contact-icon" aria-hidden="true">✉</span>
          <span><small>ESCRÍBEME POR CORREO</small><strong>aylz.contact@gmail.com</strong></span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="contact-option glass" href={profile.whatsapp} target="_blank" rel="noreferrer">
          <span class="contact-icon" aria-hidden="true">↗</span>
          <span><small>HABLEMOS POR WHATSAPP</small><strong>Enviar un mensaje</strong></span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <nav class="contact-socials" aria-label="Redes sociales">
        <a class="contact-social-link" href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <SocialIcon name="GitHub" />
        </a>
        {socialLinks.map((social) => (
          social.href ? (
            <a class="contact-social-link" href={social.href} target="_blank" rel="noreferrer" aria-label={social.name}>
              <SocialIcon name={social.name} />
            </a>
          ) : (
            <span
              class="contact-social-link contact-social-pending"
              aria-label={`${social.name}: ${social.handle}`}
              title={`${social.name}: ${social.handle}`}
            >
              <SocialIcon name={social.name} />
            </span>
          )
        ))}
      </nav>
    </section>

    <footer class="site-footer">
      <a class="footer-brand" href="#inicio">DANIEL AYALA<span>.</span></a>
      <span>© {new Date().getFullYear()} DANIEL AYALA · AYLZZ. TODOS LOS DERECHOS RESERVADOS.</span>
      <a href="#inicio">VOLVER ARRIBA <span aria-hidden="true">↑</span></a>
    </footer>
  </main>

  <script>
    const revealElements = document.querySelectorAll<HTMLElement>('[data-reveal]')

    if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.body.classList.add('motion-ready')

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.14 },
      )

      revealElements.forEach((element) => revealObserver.observe(element))
    }

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect()
          const x = (event.clientX - bounds.left) / bounds.width
          const y = (event.clientY - bounds.top) / bounds.height
          card.style.setProperty('--pointer-x', `${x * 100}%`)
          card.style.setProperty('--pointer-y', `${y * 100}%`)
          card.style.setProperty('--tilt-x', `${(0.5 - y) * 3}deg`)
          card.style.setProperty('--tilt-y', `${(x - 0.5) * 3}deg`)
        })

        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--tilt-x', '0deg')
          card.style.setProperty('--tilt-y', '0deg')
        })
      })
    }
  </script>
</BaseLayout>
